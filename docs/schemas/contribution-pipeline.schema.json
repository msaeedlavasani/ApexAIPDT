{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contribution Pipeline Schema",
  "description": "Cross-project contribution pipeline with independent review gate.",
  "type": "object",
  "required": ["contribution_id", "source_project", "target_project"],
  "properties": {
    "contribution_id": {
      "type": "string",
      "pattern": "^CONT-[A-Z0-9]+$",
      "description": "Unique contribution identifier."
    },
    "source_project": {
      "type": "string",
      "description": "Source project identifier."
    },
    "target_project": {
      "type": "string",
      "description": "Target project identifier."
    },
    "stage": {
      "type": "string",
      "enum": ["CANDIDATE", "REVIEW_PENDING", "REVIEW_COMPLETE", "POOL_ADMITTED", "REJECTED"],
      "description": "Current pipeline stage."
    },
    "reviewer_id": {
      "type": "string",
      "description": "Independent reviewer identifier."
    },
    "review_decision": {
      "type": "string",
      "enum": ["APPROVED", "CHANGES_REQUESTED", "REJECTED"]
    },
    "pool_status": {
      "type": "string",
      "enum": ["NOT_IN_POOL", "WAITING", "ADMITTED"]
    }
  }
}
