{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v02-workflows.schema.json",
  "title": "DPT Workflows Schema",
  "description": "Schema for DPT workflow definitions (repeatable ways of moving work)",
  "type": "object",
  "required": [
    "workflow_id",
    "title",
    "stages"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}